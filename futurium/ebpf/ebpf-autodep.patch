+# find a bpftool able to dump the running kernel BTF (the distro one may not support the running kernel, e.g. under WSL)
+BPFTOOL=
+for bt in bpftool /usr/sbin/bpftool /usr/lib/linux-tools/*/bpftool /usr/lib/linux-tools-*/bpftool ; do
+	if command -v "$bt" >/dev/null 2>&1 && "$bt" btf dump file /sys/kernel/btf/vmlinux format c >/dev/null 2>&1 ; then BPFTOOL=$(command -v "$bt") ; break ; fi
