+cat <<"EOF" >can_autodep_ebpf.cc
+	#include <bpf/libbpf.h>
+	static_assert(LIBBPF_MAJOR_VERSION>=1) ;
+	int main() {
+		struct bpf_object*  o  = bpf_object__open_mem(nullptr,0,nullptr)        ;
+		struct ring_buffer* rb = ring_buffer__new(0,nullptr,nullptr,nullptr) ;
+		return o==nullptr && rb==nullptr ;
+	}
+EOF
+CAN_AUTODEP_EBPF=0
+if [ "$BPF_CLANG" -a "$BPF_ARCH" -a "$BPFTOOL" ] ; then
+	if $BPFTOOL btf dump file /sys/kernel/btf/vmlinux format c >vmlinux.h 2>/dev/null && $BPF_CLANG -g -O2 -target bpf -D__TARGET_ARCH_$BPF_ARCH -I. -I$BPF_INC_DIR -c -o can_autodep_ebpf.bpf.o can_autodep_ebpf.bpf.c >/dev/null 2>&1 ; then
