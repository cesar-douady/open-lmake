+
 //
 // Gather::AccessInfo
 //
@@ -517,6 +522,7 @@ void Gather::_trace_child( Fd report_fd , ::latch* ready ) {
 	switch (method) {
 		/**/                    case AutodepMethod::Ptrace  : _child.pre_exec = AutodepPtrace ::prepare_child ; break ;
 		IF_CAN_AUTODEP_SECCOMP( case AutodepMethod::Seccomp : _child.pre_exec = AutodepSeccomp::prepare_child ; break ; )
+		IF_CAN_AUTODEP_EBPF   ( case AutodepMethod::Ebpf    : _child.pre_exec = s_ebpf_prepare_child          ; break ; )
