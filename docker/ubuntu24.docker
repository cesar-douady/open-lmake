# build command from top level : sudo docker build -f docker/ubuntu24.docker -t ubuntu24 docker ; mk_docker ubuntu24

FROM ubuntu:24.04

# in case the necesary packages are not found, it may come from a bad /etc/apt/sources.list
# and this may change from time to time. it has been seen that it was necessary to replace archive.ubuntu.com by fr.archive.ubuntu.com with a line such as :
#RUN sed s://archive.ubuntu.com/://fr.archive.ubuntu.com/: -i.bak /etc/apt/sources.list

RUN \
		# in case of failure, try to increment the number below to force docker to reexecute the update line
		: 1                          \
	&&	apt-get update --fix-missing \
	&&	apt-get install -y           \
			# compulsory
			build-essential \
			git             \
			groff m4        \
			python3-dev     \
			wget            \
			# optional
			gcc-multilib              \
			clang                     \
			gdb                       \
			g++-14                    \
			libbpf-dev                \
			libpcre2-dev              \
			libslurm-dev              \
			linux-headers-$(uname -r) \
			llvm                      \
			python3-venv              \
			#
			## necessary to build and install debian package
			dh-make devscripts debhelper equivs apparmor dh-apparmor \
			ed                                                       \
			libzstd-dev                                              \
			sudo

RUN     useradd --uid 1001 --home-dir /home/cdy cdy
RUN     echo 'cdy ALL = NOPASSWD: ALL' >> /etc/sudoers
USER    1001:1001
WORKDIR /home/cdy
ENV     USER=cdy
ENV     HOME=/home/cdy
CMD     bash
